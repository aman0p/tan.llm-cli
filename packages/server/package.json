  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@nightcode/database": "workspace:*",
    "@nightcode/shared": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.154",
    "dotenv": "^17.4.1",
    "hono": "^4.12.12",
    "jose": "^6.1.0",
    "zod": "^4.3.6"
  }
}
