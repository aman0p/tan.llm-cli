# Public URL of the API. Used by the CLI; safe to leave as-is for local dev.
API_URL=http://localhost:3000

# Neon Postgres connection string (use the pooled URL in production).
DATABASE_URL=

# Neon Auth (Managed Better Auth)
# Must exactly match the issuer advertised at /.well-known/oauth-authorization-server.
NEON_AUTH_BASE_URL=
# Public OAuth client ID registered with the callback URL ${API_URL}/auth/callback.
NEON_AUTH_CLIENT_ID=
# Resource identifier registered in Neon Auth. Changing it requires updating the Neon console.
NEON_AUTH_RESOURCE=http://localhost:3000/nightcode-api

# Optional server-wide fallback. The CLI's /set-key takes precedence.
OPENROUTER_API_KEY=

# Server port (optional; defaults to 3000). Most hosts inject PORT automatically.
PORT=3000
